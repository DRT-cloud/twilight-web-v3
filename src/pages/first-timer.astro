---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

// Each item: { t: "REQ" | "REC", text }
const checklist = [
  {
    cat: "Firearms & Carry",
    items: [
      { t: "REQ", text: "Rifle — center-fire (2Gun) or PCC (PCC division)" },
      { t: "REQ", text: "Pistol — center-fire (2Gun); optional in PCC" },
      { t: "REQ", text: "Rifle sling / retention device — must stay attached to body" },
      { t: "REQ", text: "Rigid pistol holster covering the trigger, retains while running" },
      { t: "REC", text: "Dedicated magazine carry — chest rig or belt mag pouches" },
    ],
  },
  {
    cat: "Ammunition",
    items: [
      { t: "REQ", text: "Rifle: 30–50 hits needed (bring 2× that)" },
      { t: "REQ", text: "Pistol: 40–60 hits needed (bring 2× that)" },
      { t: "REQ", text: "Loaded magazines ready to go" },
      { t: "REQ", text: "No tracers, incendiary, armor-piercing, or steel/tungsten-core projectiles" },
    ],
  },
  {
    cat: "Lighting",
    items: [
      { t: "REQ", text: "Headlamp (primary navigation light)" },
      { t: "REQ", text: "Weapon-mounted light on rifle and pistol" },
      { t: "REC", text: "Backup flashlight" },
      { t: "REQ", text: "Fresh batteries in all lights + spare batteries" },
      { t: "REQ", text: "Chem-lights — required while waiting in the Stage Waiting Area" },
    ],
  },
  {
    cat: "Safety & Medical",
    items: [
      { t: "REQ", text: "Eye protection" },
      { t: "REQ", text: "Ear protection (electronic strongly recommended)" },
      { t: "REC", text: "Tourniquet / IFAK carried on your person" },
    ],
  },
  {
    cat: "Timing & Tools",
    items: [
      { t: "REQ", text: "Stopwatch or watch with timer function" },
      { t: "REC", text: "Knife or multi-tool" },
      { t: "REC", text: "Basic weapon servicing tools, electrical tape, zip-ties" },
    ],
  },
  {
    cat: "Hydration",
    items: [
      { t: "REQ", text: "Water / hydration — hands-free pack preferred" },
    ],
  },
  {
    cat: "Clothing & Personal",
    items: [
      { t: "REQ", text: "Weather-appropriate clothing — layers for night temps" },
      { t: "REC", text: "Trail runners or boots for uneven wooded terrain at night" },
      { t: "REC", text: "Gloves — liner or trigger-finger gloves" },
      { t: "REC", text: "Change of clothes for after — you will be dirty and/or wet" },
      { t: "REC", text: "DEET bug spray (warm-season events)" },
    ],
  },
];

// Seasonal conditions — night-adapted. Add summer/winter later as needed.
const seasons = [
  {
    name: "Spring / Fall — Mild & Rain",
    intro:
      "Twilight's most common months and the most comfortable for running, but Oklahoma weather is volatile and you run after dark, when temperatures fall further and you can't see weather moving in.",
    points: [
      "Volatile by nature: a 70°F sunny afternoon can become 50°F and storming within an hour — and night lows drop further after sunset. Dress for the night, not the daytime high.",
      "Layering system: moisture-wicking base, light mid-layer, and a packable wind/rain shell that fits in a pocket or under your rig. You can't see a front coming in the dark, so carry the shell even if it's clear at check-in.",
      "Creek crossings run deeper and faster after rain — expect wet feet and plan footwear accordingly.",
      "Mud affects footing on hills and embankments — lugged-sole trail footwear is strongly recommended over road shoes, and matters more at night when you can't read the ground ahead.",
      "Check the forecast the morning of, but don't rely on it — the daytime forecast undersells the night low. Dress to manage both outcomes.",
      "Lightning: the Match Director has sole authority to suspend the event. If you hear thunder on course, find cover and wait for official calls from staff with radios.",
      "Ticks are most active in spring — DEET works; do a full check after the event.",
    ],
  },
];

const flow = [
  { num: "01", title: "Check-in", body: "Arrive during the check-in window (see the Schedule page). You'll get a start time. Be ready before that start time." },
  { num: "02", title: "Shooters meeting", body: "Mandatory. The Match Director briefs the entire field on safety, course layout, and any changes. Ask your questions here." },
  { num: "03", title: "Your release", body: "Competitors are released individually every ~5 minutes. When your name is called, move to the starting area to start your run." },
  { num: "04", title: "The course", body: "A marked 5K route through Oklahoma fields, woods, hills, and creek beds. Follow the markers. It's dark — that's the point." },
  { num: "05", title: "Shooting stages", body: "You'll hit 4 stages across 2 laps (odd/even rotation). At each stage, wait in the stage waiting area until the RO calls you. The RO supervises your entire course of fire." },
  { num: "06", title: "Finish", body: "Cross the finish line. Your total time (run – wait times + stage times + penalties) is your score." },
];

const tips = [
  { kw: "Don't rush the stages", body: "Penalties from failing to neutralize targets add up fast. Taking an extra couple seconds to settle your breathing and confirm your sight picture saves time." },
  { kw: "Hydrate before you start", body: "The course is 5K through fields and woods. In Oklahoma spring/fall weather, dehydration is real." },
  { kw: "Test your gear the night before", body: "Run around your neighborhood in the dark with your kit (your neighbors will love it). Does the sling chafe? Does the holster retain at a jog? Does your headlamp bounce? Find out before the event." },
  { kw: "Walk when you need to", body: "Nobody judges you for walking. A steady pace with clean stages beats sprinting and missing targets." },
  { kw: "Have fun", body: "The Twilight Biathlon community is one of the most welcoming in competitive shooting. People will help you, cheer for you, and swap stories after the event." },
];
---

<BaseLayout
  title="First-Timer Guide"
  description="Never done a run and gun? This is a complete walkthrough — gear, fitness, division choice, day-of flow, and tips from past competitors."
>
  <PageHeader
    eyebrow="// First-Timer Guide"
    title="Your first run."
  />

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="max-w-2xl text-[var(--color-text-muted)]">
      Everything a new competitor needs to register, prepare, and finish their
      first Twilight Biathlon with a smile.
    </p>

    {/* Before you register */}
    <div class="mt-16">
      <p class="section-label">// Before You Register</p>
      <h2 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold uppercase sm:text-4xl">
        Are you ready?
      </h2>
      <p class="mt-4 text-[var(--color-text)]/90 leading-relaxed">
        You should be an <strong>experienced shooter</strong> before entering.
        This is not the place to learn the basics. You need to be comfortable with:
      </p>
      <ul class="mt-4 space-y-2">
        {[
          "Loading, unloading, and making safe your rifle and pistol",
          "Engaging targets from standing, kneeling, and prone positions",
          "Moving with loaded firearms",
          "Basic firearm malfunction remediation",
        ].map((it) => (
          <li class="flex gap-3 text-[var(--color-text)]/90">
            <span class="text-[var(--color-nv)] pt-1 shrink-0">→</span>
            <span>{it}</span>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-[var(--color-text)]/90 leading-relaxed">
        You do not need to be a fast runner. Many competitors walk significant
        portions of the course. The community is welcoming and the atmosphere is
        encouraging — finishing is the goal.
      </p>
    </div>

    {/* Which division */}
    <div class="mt-20 border-y border-[var(--color-hairline)] py-12">
      <p class="section-label">// Which Division?</p>
      <h2 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold uppercase sm:text-4xl">
        Pick your night.
      </h2>

      <div class="mt-8 space-y-6">
        <div class="border-l-2 border-[var(--color-nv)] pl-5">
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold uppercase tracking-wide">
            Saturday 2Gun <span class="text-[var(--color-nv)]">— recommended for first-timers</span>
          </p>
          <p class="mt-2 text-[var(--color-text)]/90 leading-relaxed">
            White-light division. Bring a rifle, pistol, headlamp, and weapon
            lights. The course is completely dark, but you control your own
            illumination.
          </p>
        </div>

        <div class="border-l-2 border-[var(--color-hairline)] pl-5">
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold uppercase tracking-wide">
            PCC
          </p>
          <p class="mt-2 text-[var(--color-text)]/90 leading-relaxed">
            Pistol caliber carbine. Good option if you don't want to manage two
            firearms — uses a single primary; pistol is optional.
          </p>
        </div>

        <div class="border-l-2 border-[var(--color-wl)] pl-5">
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold uppercase tracking-wide">
            Friday NV divisions <span class="text-[var(--color-wl)]">— experienced NV shooters only</span>
          </p>
          <p class="mt-2 text-[var(--color-text)]/90 leading-relaxed">
            NV 2Gun and NV PCC. Require night vision devices and prohibit white
            light. Not the place to use NV for the first time.
          </p>
        </div>
      </div>
    </div>

    {/* Gear checklist */}
    <div class="mt-20">
      <p class="section-label">// Gear Checklist</p>
      <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="font-[family-name:var(--font-display)] text-3xl font-bold uppercase sm:text-4xl">
          What to bring.
        </h2>
        <button
          type="button"
          onclick="printGearChecklist()"
          class="btn-ghost text-sm self-start sm:self-auto"
        >
          <span aria-hidden="true">⎙</span>
          Print checklist
        </button>
      </div>
      <p class="mt-3 text-[var(--color-text-muted)]">
        Carry all gear from start to finish. No resupply at your vehicle.
      </p>
      <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[var(--color-text-muted)]">
        <span class="inline-flex items-center gap-1.5">
          <span class="rounded-sm border border-[var(--color-wl)] px-1.5 py-0.5 font-[family-name:var(--font-mono)] text-[10px] font-semibold uppercase text-[var(--color-wl)]">REQ</span>
          Required
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="rounded-sm border border-[var(--color-nv)] px-1.5 py-0.5 font-[family-name:var(--font-mono)] text-[10px] font-semibold uppercase text-[var(--color-nv)]">REC</span>
          Recommended
        </span>
      </p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {checklist.map((cat) => (
          <div class="border border-[var(--color-hairline)] p-5">
            <p class="font-[family-name:var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-nv)]">
              {cat.cat}
            </p>
            <ul class="mt-4 space-y-2">
              {cat.items.map((item) => (
                <li class="flex gap-2.5 text-sm text-[var(--color-text)]/90">
                  <span
                    class={`mt-0.5 shrink-0 rounded-sm border px-1 py-0 font-[family-name:var(--font-mono)] text-[10px] font-semibold uppercase leading-tight ${item.t === "REQ" ? "border-[var(--color-wl)] text-[var(--color-wl)]" : "border-[var(--color-nv)] text-[var(--color-nv)]"}`}
                  >
                    {item.t}
                  </span>
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 border-l-2 border-[var(--color-wl)] bg-[var(--color-wl)]/5 p-5">
        <p class="font-bold uppercase tracking-wide text-[var(--color-wl)]">
          A light failure on course costs time.
        </p>
        <p class="mt-2 text-[var(--color-text)]/90 leading-relaxed">
          Your headlamp is your most critical piece of non-firearm gear. Bring
          a backup. Fresh batteries. Test everything before you leave the
          parking area.
        </p>
      </div>
    </div>

    {/* Seasonal conditions */}
    <div class="mt-20">
      <p class="section-label">// Seasonal Conditions</p>
      <h2 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold uppercase sm:text-4xl">
        Plan for conditions.
      </h2>
      <p class="mt-3 text-[var(--color-text-muted)]">
        Don't just react to them. Twilight runs after dark — dress for the night, not the daytime high.
      </p>

      <div class="mt-8 space-y-8">
        {seasons.map((s) => (
          <div class="border-l-2 border-[var(--color-nv)] pl-5">
            <p class="font-[family-name:var(--font-display)] text-xl font-semibold uppercase tracking-wide">
              {s.name}
            </p>
            <p class="mt-2 text-[var(--color-text)]/90 leading-relaxed">{s.intro}</p>
            <ul class="mt-4 space-y-2">
              {s.points.map((pt) => (
                <li class="flex gap-3 text-sm text-[var(--color-text)]/90">
                  <span class="text-[var(--color-nv)]/70 shrink-0">▸</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {/* Day of */}
    <div class="mt-20">
      <p class="section-label">// On Course</p>
      <h2 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold uppercase sm:text-4xl">
        What to expect.
      </h2>
      <ol class="mt-8 space-y-4">
        {flow.map((s) => (
          <li class="flex gap-5 border-l-2 border-[var(--color-nv)]/40 pl-5">
            <span class="font-[family-name:var(--font-mono)] text-sm text-[var(--color-nv)] pt-1 shrink-0">{s.num}</span>
            <div>
              <p class="font-[family-name:var(--font-display)] text-xl font-semibold uppercase tracking-wide">{s.title}</p>
              <p class="mt-2 text-[var(--color-text)]/90 leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    {/* Tips */}
    <div class="mt-20">
      <p class="section-label">// Tips From Past Competitors</p>
      <h2 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold uppercase sm:text-4xl">
        Hard-earned advice.
      </h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {tips.map((t) => (
          <div class="border border-[var(--color-hairline)] p-5">
            <p class="font-[family-name:var(--font-display)] text-lg font-semibold uppercase tracking-wide text-[var(--color-text)]">
              {t.kw}
            </p>
            <p class="mt-2 text-sm text-[var(--color-text)]/90 leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>
    </div>

    {/* After */}
    <div class="mt-20 border-y border-[var(--color-hairline)] py-12">
      <p class="section-label">// After the Event</p>
      <h2 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold uppercase sm:text-4xl">
        Scoring, awards, t-shirt.
      </h2>
      <ul class="mt-6 space-y-3 text-[var(--color-text)]/90 leading-relaxed">
        <li><strong>Scoring.</strong> Scores are usually ready within an hour of all stages reporting in after the final competitor completes the course.</li>
        <li><strong>Awards ceremony.</strong> Top 3 in each division — presented Saturday night after all scoring is complete (usually very early Sunday morning). Stick around.</li>
        <li><strong>Your t-shirt.</strong> Every registered competitor receives a Twilight Biathlon t-shirt at the event.</li>
      </ul>
    </div>

    {/* CTA */}
    <div class="mt-16 flex flex-col gap-4 border-t border-[var(--color-hairline)] pt-10 sm:flex-row sm:items-center">
      <a href="/register" class="btn-primary text-sm">Register</a>
      <a href="/rules" class="btn-ghost text-sm">Read the Rules</a>
      <a href="/location" class="btn-ghost text-sm">Get directions</a>
    </div>

    <div class="mt-8">
      <a
        href="/gallery/#videos"
        class="inline-flex items-center gap-2 text-sm text-[var(--color-text)]/90 hover:text-[var(--color-nv)]"
      >
        <span class="text-[var(--color-nv)]">→</span>
        <span>Watch a first-timer's full event experience in the Media gallery</span>
      </a>
    </div>
  </section>
  {/* ===================================================================
       PRINT SHEET — hidden on screen, the only thing that prints.
       Page 1: checklist + seasonal conditions. Page 2: on-course flow.
       Content is driven by the same arrays as the visible page so the two
       can never drift apart.
  ==================================================================== */}
  <div id="print-sheet" aria-hidden="true">
    {/* PAGE 1 — checklist + seasonal */}
    <section class="ps-page">
      <div class="ps-head">
        <h1 class="ps-title">Twilight Biathlon — Gear Checklist</h1>
        <div class="ps-legend">
          <span class="ps-tag ps-tag--req">REQ</span> Required
          <span class="ps-tag ps-tag--rec">REC</span> Recommended
        </div>
      </div>
      <p class="ps-note">Carry all gear from start to finish. No resupply at your vehicle.</p>

      <div class="ps-grid">
        {checklist.map((cat) => (
          <div class="ps-cat">
            <h2 class="ps-cat__title">{cat.cat}</h2>
            <ul class="ps-list">
              {cat.items.map((item) => (
                <li>
                  <span class="ps-box"></span>
                  <span class={`ps-tag ${item.t === "REQ" ? "ps-tag--req" : "ps-tag--rec"}`}>{item.t}</span>
                  <span class="ps-item-text">{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="ps-season">
        {seasons.map((s) => (
          <div class="ps-cat ps-cat--season">
            <h2 class="ps-cat__title">Seasonal — {s.name}</h2>
            <ul class="ps-list ps-list--bullets">
              {s.points.map((pt) => (<li>{pt}</li>))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {/* PAGE 2 — on-course reference */}
    <section class="ps-page">
      <div class="ps-head">
        <h1 class="ps-title">On Course — What to Expect</h1>
      </div>
      <ol class="ps-flow">
        {flow.map((s) => (
          <li>
            <span class="ps-flow__num">{s.num}</span>
            <div>
              <span class="ps-flow__title">{s.title}</span>
              <span class="ps-flow__body">{s.body}</span>
            </div>
          </li>
        ))}
      </ol>
      <p class="ps-foot">twilightbiathlon.com/first-timer</p>
    </section>
  </div>

  <script is:inline>
    function printGearChecklist() {
      document.body.classList.add("printing-gear");
      window.onafterprint = function () {
        document.body.classList.remove("printing-gear");
        window.onafterprint = null;
      };
      window.print();
    }
  </script>

  <style is:global>
    /* Hidden on screen — never shown unless printing. */
    #print-sheet { display: none; }

    @media print {
      /* Portrait, tight margins. */
      @page { size: portrait; margin: 12mm; }

      /* Kill the dark theme + camo background/scrim so pages print clean.
         Hide via display:none (NOT visibility:hidden, which leaves dark
         boxes and prints black/blank pages). */
      html { background: #fff !important; }
      body.printing-gear,
      body:has(#print-sheet) {
        background: #fff !important;
        background-image: none !important;
        color: #111 !important;
      }
      body.printing-gear::before,
      body:has(#print-sheet)::before { display: none !important; content: none !important; }

      /* The print sheet renders INSIDE <main> (Astro slot), so the ancestor
         chain is body > main > #print-sheet. Hide everything except that
         chain: hide direct body children that are NOT <main>, and hide every
         child of <main> that is NOT the print sheet. */
      body.printing-gear > *:not(main),
      body:has(#print-sheet) > *:not(main) { display: none !important; }

      body.printing-gear main > *:not(#print-sheet),
      body:has(#print-sheet) main > *:not(#print-sheet) { display: none !important; }

      /* Keep the ancestor <main> rendering but strip its layout/positioning. */
      body.printing-gear main,
      body:has(#print-sheet) main {
        display: block !important;
        position: static !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      /* Reveal the print sheet. */
      #print-sheet {
        display: block !important;
        width: 100% !important;
        max-width: 186mm !important; /* portrait width-lock against landscape reflow */
        margin: 0 auto !important;
        background: #fff !important;
        color: #111 !important;
        font-family: "Inter", Arial, sans-serif;
      }
      #print-sheet * { background: transparent !important; color: #111 !important; }

      .ps-page { page-break-after: always; }
      .ps-page:last-child { page-break-after: auto; }

      .ps-head {
        display: flex; align-items: baseline; justify-content: space-between;
        gap: 12px; border-bottom: 2px solid #111; padding-bottom: 5px; margin-bottom: 8px;
      }
      .ps-title {
        font-family: "Barlow Condensed", "Arial Narrow", Arial, sans-serif;
        font-size: 19px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; margin: 0;
      }
      .ps-legend { font-size: 9px; white-space: nowrap; }
      .ps-note { font-size: 9px; color: #555 !important; margin: 0 0 8px; }

      .ps-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 6px 18px;
      }
      .ps-cat { break-inside: avoid; margin-bottom: 4px; }
      .ps-cat__title {
        font-family: "Barlow Condensed", "Arial Narrow", Arial, sans-serif;
        font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
        margin: 4px 0 3px; border-bottom: 0.75px solid #bbb; padding-bottom: 1px;
      }
      .ps-list { list-style: none; margin: 0; padding: 0; }
      .ps-list li {
        display: flex; align-items: flex-start; gap: 4px; padding: 1.5px 0;
        font-size: 9.5px; line-height: 1.25; break-inside: avoid;
      }
      .ps-item-text { flex: 1; }

      /* Empty checkbox — needs print-color-adjust to render the border. */
      .ps-box {
        flex: 0 0 auto; display: inline-block; width: 10px; height: 10px;
        border: 1.25px solid #333 !important; border-radius: 2px; margin-top: 1px;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }

      /* Outline-only REQ/REC tags. */
      .ps-tag {
        flex: 0 0 auto; font-size: 7px; font-weight: 700; letter-spacing: 0.04em;
        padding: 1px 3px; border-radius: 3px; margin: 1px 0 0; white-space: nowrap;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      .ps-tag--req { color: #c0392b !important; border: 1px solid #c0392b !important; }
      .ps-tag--rec { color: #b8902f !important; border: 1px solid #c29f5a !important; }

      /* Seasonal block = bullet reference, no checkboxes. */
      .ps-season { margin-top: 6px; break-inside: avoid; }
      .ps-cat--season .ps-cat__title { margin-top: 6px; }
      .ps-list--bullets li { display: list-item; list-style: disc; margin-left: 14px; font-size: 9px; line-height: 1.3; }

      /* On-course flow (page 2). */
      .ps-flow { list-style: none; margin: 0; padding: 0; }
      .ps-flow li { display: flex; gap: 8px; padding: 5px 0; border-bottom: 0.5px solid #ddd; break-inside: avoid; }
      .ps-flow__num {
        font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 700;
        color: #555 !important; flex: 0 0 auto;
      }
      .ps-flow__title {
        display: block; font-family: "Barlow Condensed", "Arial Narrow", Arial, sans-serif;
        font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
      }
